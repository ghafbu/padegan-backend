# DOCKER
COMPOSE_PROJECT_NAME=padegan

# Application
APPLICATION_NAME=padegan-backend
APPLICATION_VERSION=0.1.0
APPLICATION_DEBUG=true

# OTP code
OTP_CODE_LENGTH=5
OTP_CODE_CHARS=0123456789

# HTTP
HTTP_URL=https://localhost
HTTP_HOST=localhost
HTTP_PORT_HTTP=80
HTTP_PORT_HTTPS=443
HTTP_PROTOCOL=https

# EXPIRE DURATION
EXPIRE_DURATION_1M=1m
DURATION_2M=2m
DURATION_3M=3m
EXPIRE_DURATION_4M=4m
EXPIRE_DURATION_8M=8m
EXPIRE_DURATION_1W=10080m # ACCESS
EXPIRE_DURATION_1Y=525600m # REFRESH

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=padegan_db
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_IDLE_CONNS=15
POSTGRES_MAX_OPEN_CONNS=100
POSTGRES_CONN_MAX_LIFE_TIME="5ms"
POSTGRES_LOG_LEVEL=2 # 1(silent), 2(error), 3(warm), 4(info) | 1 for production, 2 for development

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=password123
REDIS_DB=0
REDIS_DIAL_TIMEOUT="5ms"
REDIS_READ_TIMEOUT="5ms"
REDIS_WRITE_TIMEOUT="5ms"
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT="15ms"
REDIS_IDLE_CHECK_FREQUENCY="500ms"

# View Info
VIEW_PATH=./app/http/web/view
VIEW_EXTENSION=.html

# Static Files Path
STATIC_PATH=./assets

# SECRET KEY []
SECRET_KEY_AES=N1PCdw3M2B1TfJhoaY2mL736p2vCUc47
SECRET_KEY_JWT_PUBLIC=MYSECRETREFRESHKEY
SECRET_KEY_JWT_AUTH_ACCESS=MYSECRETREFRESHKEY
SECRET_KEY_JWT_AUTH_REFRESH=MYSECRETREFRESHKEY
SECRET_KEY_JWT_RESET_PASSWORD=MYSECRETREFRESHKEY


# LOG
LOGGER_FILEPATH=./logs
LOGGER_ENCODING=json
LOGGER_LEVEL=debug
LOGGER_LOGGER=zap

# OTHER
SECURITY_PASSWORD_ENTROPY=80
CMD_GRACEFUL_SHUTDOWN_TIMEOUT="30s"
